# Copy to .env for local dev. NEVER commit the real .env file.

# "development" for local work. Anything else (including unset) = production-strict mode.
APP_ENV=development

# Required in production (app refuses to start without it). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Paystack LIVE secret key in production (sk_live_...). Also set the webhook URL in the Paystack dashboard:
#   https://YOUR-DOMAIN/paystack-webhook
PAYSTACK_SECRET_KEY=

DATABASE_URL=sqlite:///mall.db

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

# Content-Security-Policy: start as "report-only", open the site in a browser, check the console for
# violations, then switch to "enforce".
CSP_MODE=report-only

# Only if the site is reachable from more than one origin (custom domain + onrender.com):
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Number of reverse proxies in front of the app (Render/Heroku = 1). Use 0 if none.
# TRUST_PROXY_HOPS=1

# Set in production so password-reset links in emails always use YOUR domain:
# PUBLIC_BASE_URL=https://your-domain.com
